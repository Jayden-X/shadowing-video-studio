# Copy to .env for local development. Never commit .env.

# Optional AI text-processing providers
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Codex reuses the existing local `codex login`. No separate API key is required.
# Optional server-side executable path; leave empty to discover codex on PATH.
CODEX_EXECUTABLE=

# AI preparation timeout in seconds (1–110); failures are not automatically retried.
TEXT_PROVIDER_TIMEOUT_SECONDS=60

# Runtime defaults (names may change once the implementation stack is selected)
APP_ENV=development

# Optional local CPU speech. Empty paths keep speech unavailable; no auto install/download.
# Existing absolute workspace, e.g. an ignored runtime directory under the approved project.
SPEECH_WORKSPACE=
# Absolute path to the frozen local 0.6B CustomVoice HF snapshot (40-character revision).
SPEECH_MODEL_PATH=
# Existing isolated Python 3.12 runtime containing Qwen 0.1.1; blank uses backend Python.
SPEECH_PYTHON_EXECUTABLE=
# Per-sentence deadline (30–1800 seconds), including first model load.
SPEECH_TIMEOUT_SECONDS=600
